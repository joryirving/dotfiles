{
  "mcpServers": {
    "toolhive": {
      "url": "https://mcp.jory.dev/mcp",
      "headers": {
        "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}"
      },
      "exposure": "deferred",
      "description": "Toolhive gateway hosting many downstream MCP servers and tools."
    },
    "dispatch": {
      "command": "npx",
      "args": ["tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "env": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      },
      "exposure": "direct",
      "description": "Dispatch issue tracker: claim and work GitHub issues and PR-fix queue items."
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      },
      "exposure": "direct",
      "description": "Context7: current library documentation and code examples."
    }
  }
}
