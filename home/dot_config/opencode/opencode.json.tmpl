{
  "$schema": "https://opencode.ai/config.json"
{{- if .personal }}
  , "plugin": [
    ["@eleboucher/opencode-memini@0.7.18", { "base_url": "https://memini.jory.dev", "namespace": "opencode" }]
  ]
  , "enabled_providers": [{{ if eq .chezmoi.os "darwin" }}"lmstudio", {{ end }}"litellm-anthropic", "litellm"]
  , "model": "litellm/auto"
  , "provider": {
    {{- if eq .chezmoi.os "darwin" }}
    {{/* LM Studio runs locally on macOS only; absent off-Mac (Rpi5 jumpbox). */}}
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": { "name": "Qwen3.6 35B-A3B" },
        "gemma-4-26b-a4b-it-qat": { "name": "Gemma 4 26B" }
      }
    },
    {{- end }}
{{ template "shared/litellm-opencode-anthropic" . }},
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM OpenAI",
      "options": {
        "baseURL": "https://litellm.jory.dev/v1",
        "apiKey": "{{ onepasswordRead "op://Kubernetes/litellm/LITELLM_OPENCODE_API_KEY" }}",
        "timeout": 1800000
      },
      "models": {
{{ template "shared/litellm-opencode-models" . }},
        "chatgpt/gpt-5.6-sol": { "name": "ChatGPT GPT-5.6 Sol", "limit": { "context": 1100000, "output": 128000 } },
        "chatgpt/gpt-5.6-terra": { "name": "ChatGPT GPT-5.6 Terra", "limit": { "context": 1050000, "output": 128000 } },
        "chatgpt/gpt-5.6-luna": { "name": "ChatGPT GPT-5.6 Luna", "limit": { "context": 1050000, "output": 128000 } },
        "chatgpt/gpt-5.5": { "name": "ChatGPT GPT-5.5", "limit": { "context": 400000, "output": 128000 } },
        "chatgpt/gpt-5.4": { "name": "ChatGPT GPT-5.4", "limit": { "context": 400000, "output": 128000 } },
        "chatgpt/gpt-5.4-mini": { "name": "ChatGPT GPT-5.4 Mini", "limit": { "context": 400000, "output": 128000 } }
      }
    }
  }
  , "mcp": {
    "mcp-server-context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      }
    },
    "toolhive": {
      "type": "remote",
      "url": "https://mcp.jory.dev/mcp"
    },
    "konflate": {
      "type": "remote",
      "url": "https://konflate.jory.dev/mcp"
    },
    "dispatch": {
      "type": "local",
      "command": ["npx", "tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "enabled": true,
      "environment": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      }
    }
    {{- if eq .chezmoi.os "darwin" }}
    {{/* macOS-only local servers (Homebrew binaries). Off-Mac (e.g. Rpi5 jumpbox)
         these tools are reached through the toolhive gateway, which aggregates them. */}}
    , "github": {
      "type": "local",
      "command": ["/opt/homebrew/lib/node_modules/@modelcontextprotocol/server-github/dist/index.js"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ onepasswordRead "op://Kubernetes/github-miso/GITHUB_TOKEN" }}"
      }
    }
    , "kubectl": {
      "type": "local",
      "command": ["/opt/homebrew/lib/node_modules/@strowk/mcp-k8s-darwin-arm64/bin/mcp-k8s-go"],
      "enabled": true
    }
    , "unifi-network": {
      "type": "local",
      "command": ["uvx", "--python-preference", "system", "unifi-network-mcp@latest"],
      "enabled": true,
      "environment": {
        "UNIFI_NETWORK_HOST": "unifi.internal",
        "UNIFI_NETWORK_USERNAME": "{{ onepasswordRead "op://Kubernetes/unifi/OPENCODE_UNIFI_USER" }}",
        "UNIFI_NETWORK_PASSWORD": "{{ onepasswordRead "op://Kubernetes/unifi/OPENCODE_UNIFI_PASS" }}",
        "UNIFI_TOOL_REGISTRATION_MODE": "meta_only",
        "UNIFI_POLICY_CREATE": "false",
        "UNIFI_POLICY_UPDATE": "false",
        "UNIFI_POLICY_DELETE": "false",
        "UNIFI_TOOL_PERMISSION_MODE": "confirm"
      }
    }
    {{- end }}
  }
  , "agent": {
    {{/* Coordinator + role subagents (taxonomy borrowed from oh-my-opencode:
         explorer/fixer/fixer-bigctx/oracle/reviewer, council as a coordinator behavior).
         Strong reasoning coordinator plans and delegates via the task tool;
         everyday default stays `auto`. Tab to coordinator for orchestration.

         Routing bias: explorer/fixer-bigctx/oracle (dsv4f / qwen3.7-plus / dsv4p) all
         sit on the Opencode Go sub — flat monthly, marginal cost ~0, and badly underused
         since the other models moved off it. So the coordinator prompt pushes work there
         by default. `nvidia` stays the low-latency lane for small edits; `self-hosted` is
         demoted to `fixer-local` backfill because that box is perpetually pinned.
         Coordinator itself stays on reasoning-pool so the planner is a different family
         than `oracle` — otherwise the second opinion is worthless. */}}
    "coordinator": {
      "description": "Reasoning coordinator — plans, then delegates to role subagents (explorer/fixer/fixer-bigctx/vision/oracle/reviewer/fixer-local)",
      "mode": "primary",
      "model": "litellm/reasoning-pool",
      "prompt": "You are a coordinator. Do the high-level reasoning and synthesis yourself; delegate the legwork to role subagents via the task tool.\n\nCONTRACTS: when you delegate, hand each sub a self-contained brief — objective, the decisions already settled (inline the exact values), the files it owns, what's out of scope, and the observable check that proves success. A sub should never have to infer scope or re-derive a decision you already made.\n\nCAPACITY POLICY: `explorer`, `fixer-bigctx`, and `oracle` all resolve to a flat-rate subscription — their marginal token cost is effectively zero and the plan is currently underused. Use them freely and in parallel. Do not hoard them, ration them, or do work yourself to avoid spending them. `fixer` (nvidia) is the low-latency lane for small scoped edits. `fixer-local` (self-hosted) is perpetually saturated — backfill of last resort, only when every other lane is busy or unsuitable.\n\nROLES:\n- `explorer` (dsv4f — 1M ctx, prepaid): default recon. Codebase search, 'where/how is X', parallel scouting. Read-only. Fan out several at once; this is the cheapest way to buy context.\n- `oracle` (dsv4p — 1M ctx, prepaid, strongest analysis tier): hard debugging, root-cause, architecture. Read-mostly; return analysis, don't sprawl into edits.\n- `fixer-bigctx` (qwen3.7-plus — 1M ctx, prepaid): primary bulk coding lane. Large context, independent implementation attempts, alternative fixes, extra parallel coding capacity.\n- `fixer` (nvidia — Qwen3.6-27B, 131k, no vision): fast local coder. Prefer it for small, well-bounded edits where latency matters.\n- `vision` (standalone vision model, 262k, vision): the only image-capable lane. Use when a task must read images.\n- `reviewer` (MiniMax M3): independent second opinion and creative/prose.\n- `fixer-local` (self-hosted — Ornith 1.0 35B agentic-coding MoE, 262k, 3 slots): local backfill once the prepaid lanes and `fixer` are exhausted. Expect queueing; it is usually pinned.\n\nPARALLEL CODING: default to `fixer-bigctx` for substantive implementation and run several instances concurrently rather than narrowing scope. Use `fixer` alongside it for the small fast edits. Use `vision` when images are involved. Spill to `fixer-local` only after the prepaid lanes and `fixer` are saturated.\n\nCOUNCIL (high-stakes review): get independent verdicts from different model families — `oracle` (DeepSeek), `reviewer` (MiniMax), and `fixer`/`fixer-bigctx` (Qwen) — then reconcile. Never let one model grade its own work."
    },
    "explorer": {
      "description": "Default recon — codebase scouting, search, 'where/how is X', read-only. DeepSeek V4 Flash (1M ctx, prepaid): fan out freely, several at a time.",
      "mode": "subagent",
      "model": "litellm/dsv4f"
    },
    "fixer": {
      "description": "Fast scoped edits — Qwen3.6-27B local (131k, no vision). Low latency; prefer it for small, well-bounded changes.",
      "mode": "subagent",
      "model": "litellm/nvidia"
    },
    "fixer-bigctx": {
      "description": "Primary bulk coding lane — Qwen3.7 Plus (1M ctx, prepaid). Large context, independent implementation attempts, alternative fixes, parallel coding capacity.",
      "mode": "subagent",
      "model": "litellm/qwen3.7-plus"
    },
    "vision": {
      "description": "Vision / image tasks — standalone vision model (262k, vision). The only image-capable lane; use when a task must read images.",
      "mode": "subagent",
      "model": "litellm/vision"
    },
    "oracle": {
      "description": "Hard debugging / architecture — DeepSeek V4 Pro (1M ctx, prepaid, strongest analysis tier). Read-mostly deep analysis; return a recommendation, don't sprawl into edits",
      "mode": "subagent",
      "model": "litellm/dsv4p"
    },
    "reviewer": {
      "description": "Independent review / creative — MiniMax M3 (distinct family from the Qwen coders and the DeepSeek analysis lanes). Second opinions and prose.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M3"
    },
    "fixer-local": {
      "description": "Local backfill — Ornith 1.0 35B agentic-coding MoE (262k, no vision, 3 slots). Use only once the prepaid lanes and `fixer` are exhausted; usually pinned, expect queueing.",
      "mode": "subagent",
      "model": "litellm/self-hosted"
    },
    "lean": {
      "description": "Minimal MCP context — toolhive router only (reaches other MCPs via call_tool)",
      "mode": "primary",
      "tools": {
        "mcp-server-context7*": false,
        "github*": false,
        "kubectl*": false,
        "konflate*": false,
        "dispatch*": false
      }
    },
    "gitops": {
      "description": "Cluster ops — kubectl/konflate direct on macOS; via toolhive router off-Mac",
      "mode": "primary",
      "tools": {
        "mcp-server-context7*": false,
        "github*": false,
        "dispatch*": false
        {{- if eq .chezmoi.os "darwin" }}
        {{/* kubectl run as local binary here, so reach them directly and
             skip the toolhive router. */}}
        , "toolhive*": false
        {{- end }}
        {{/* Off-Mac the local binaries are absent (see mcp block), so toolhive is
             left enabled — its find_tool/call_tool router reaches kubectl/etc. */}}
      }
    }
  }
{{- else }}
{{ includeTemplate "work/opencode.json" . }}
{{- end }}
}
