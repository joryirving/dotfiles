{
  "$schema": "https://opencode.ai/config.json"
  , "compaction": { "auto": true, "keep": { "tokens": 20000 }, "buffer": 16384 }
  , "tool_output": { "max_lines": 800, "max_bytes": 16384 }
{{- if .personal }}
  , "plugins": [
    { "package": "@eleboucher/opencode-memini-v2@0.7.36", "options": { "base_url": "https://memini.jory.dev", "namespace": "opencode" } }
  ]
  , "enabled_providers": [{{ if eq .chezmoi.os "darwin" }}"lmstudio", {{ end }}"litellm-anthropic", "litellm"]
  , "model": "litellm-anthropic/auto"
  , "provider": {
    {{- if eq .chezmoi.os "darwin" }}
    {{/* LM Studio runs locally on macOS only; absent off-Mac (Rpi5 jumpbox). */}}
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
{{ includeTemplate "shared/lmstudio-opencode-models" . }}
      }
    },
    {{- end }}
{{ template "shared/litellm-opencode-anthropic" . }},
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM OpenAI",
      "options": {
        "baseURL": "https://litellm.jory.dev/v1",
        "apiKey": "{{ onepasswordRead "op://Kubernetes/litellm/LITELLM_OPENCODE_API_KEY" }}",
        "timeout": 1800000
      },
      "models": {
{{ template "shared/litellm-opencode-models" . }},
        "chatgpt/gpt-6-astra": { "name": "ChatGPT GPT-6 Astra", "limit": { "context": 272000, "output": 128000 } },
        "chatgpt/gpt-6.1-sol": { "name": "ChatGPT GPT-6.1 Sol", "limit": { "context": 272000, "output": 128000 } },
        "chatgpt/gpt-6-luna": { "name": "ChatGPT GPT-6 Luna", "limit": { "context": 272000, "output": 128000 } }
      }
    }
  }
  , "mcp": {
    "mcp-server-context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      }
    },
    "toolhive": {
      "type": "remote",
      "url": "https://mcp.jory.dev/mcp",
      "headers": {
        "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}"
      }
    },
    "dispatch": {
      "type": "local",
      "command": ["npx", "tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "enabled": true,
      "environment": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      }
    }
  }
  , "agent": {
    {{/* Coordinator + role subagents. A strong reasoning coordinator plans and
         delegates via the task tool; everyday default stays `auto`. Tab to
         `coordinator` (cloud + local lanes) or `coordinator-local` (on-prem only)
         for orchestration.

         Cloud subscriptions are quota-limited, including fixed-price plans; do not
         assume any role costs nothing or that only oracle is rate-capped. coder-local (Qwen3.8-27B on the 3090,
         text-only) and agentic-local (Qwen3.8-Flash-Next on Strix, vision) are the
         self-hosted coding lanes. Coordinator itself stays on
         reasoning-pool so the planner is a different family than `oracle` — otherwise
         the second opinion is worthless. */}}
    "coordinator": {
      "description": "Reasoning coordinator — handles small low-risk work directly and delegates selectively to role subagents",
      "mode": "primary",
      "model": "litellm/reasoning-pool",
      "prompt": "You are a coordinator. Reason, implement bounded work directly, integrate, and verify. Delegation is optional, not your identity.\n\nWORKFLOW: optimize correct completed work per unit of time and total tokens. Make understood, bounded changes yourself. Delegate only when specialization, an isolated context, or genuinely independent parallel work outweighs worker startup, reading, coordination and verification cost. A task likely to take about fifteen targeted tool calls usually stays here; that is an estimate, not a counter. No automatic explorer, implementer, or reviewer sequence; never spawn agents to fill slots.\n\nCONTEXT: use targeted searches and reads, not broad dumps or repeated rediscovery. Keep only decision-relevant evidence. Context limits are ceilings, not targets: decompose or compact well before pressure builds. A handoff contains the objective, settled decisions, owned files, exclusions, acceptance check and compact evidence references, never a full transcript. Ask workers for findings, changed paths, checks and unresolved facts, not file dumps. Do not claim a fresh-session continuation unless the harness supports it.\n\nVERIFICATION: inspect the diff and use the cheapest relevant check. Record command, cwd/state, result and limitations compactly when verification is needed; a trivial edit needs no elaborate receipt. Reuse passing evidence while relevant code, dependencies, configuration and environment are unchanged. Rerun only for missing/stale evidence or a concrete concern. Distinguish measured results from assumptions.\n\nREVIEW GATE: decide from the changed behavior and failure modes, not the file extension, line count, or desire for a completion ritual. Do understood low-risk work directly: prose-only Markdown, typos/comments, formatting, mechanical renames, and routine YAML/config edits need self-verification, not a review subagent. This applies even inside instruction files when semantics are unchanged. Dependency/lockfile bumps are not automatically low-risk: inspect upstream impact first. Require one bounded independent review for nontrivial behavioral changes, new failure modes, or concrete consequential risk, including changes to permissions/authentication, secret exposure, destructive storage/recovery, financial operations, concurrency, or CI enforcement. Review actual authority, destructive-data/recovery, financial, or concurrency behavior changes even when one line; a large mechanical diff need not qualify. Agent instructions and lane profiles are behavioral configuration, not ordinary prose; judge their semantic changes by the same risk rule. Never weaken an explicit repository or user review requirement.\n\nWhen review is warranted, provide goal, diff, relevant files and existing test facts, not the author's rationale or session transcript. Ask for concrete defects and missing coverage in the affected behavior. Reuse valid checks; run extra checks only for a concrete concern or missing/stale evidence. Re-review only material fixes or unresolved findings, not the whole task again. Stop when acceptance conditions are met. No unsolicited polish or extra reviewers. Council/multiple reviewers require an explicit request or a specific unresolved high-stakes question that one reviewer cannot resolve.\n\nLANES: keep current model assignments; choose a worker only after delegation is justified.\n- `implementer`: default for delegated implementation after the approach is settled; text-only, cloud-led and quota-limited.\n- `explorer`: optional bounded read-only discovery for genuine uncertainty, not routine reconnaissance.\n- `oracle`: difficult debugging or architecture needing an additional analysis pass, not a default escalation.\n- `reviewer`: the one independent review lane when the review gate applies.\n- `coder-local`: shared 3090 fallback only when implementer is unavailable or failing; one scoped task at a time, no fan-out. Do not assume two deep requests fit.\n- `agentic-local`: shared Flash-Next lane for justified long-horizon work; first decompose rather than filling its larger context. Shared with automated work; no automatic local overflow or extra agents merely because capacity is unmetered.\n- `vision-local`: image analysis when needed. Respect each worker's actual vision support.\nAll cloud plans have quotas; local engines have shared capacity. Do not treat either as free capacity. Parallelize only genuinely independent work when the end-to-end benefit exceeds contention and coordination costs."
    },
    "vision-local": {
      "description": "Local vision lane - Qwen3.8-Flash-Next on Strix (262k, images). Use for screenshots, diagrams, OCR and any image input; the local coding models are text-only.",
      "mode": "subagent",
      "model": "litellm/qwen3.8-flash-next",
      "prompt": "You read images. Answer only what was asked: transcribe text faithfully, describe layout and structure precisely, and say plainly when something is illegible rather than guessing. Keep it compact - you are feeding a coordinator, not a human reader."
    },
    "coordinator-local": {
      "description": "Local-only coordinator - Qwen3.8-Flash-Next (qwen3.8-flash-next, 262k, vision) plans, delegates edits and recon to coder-local (qwen3.8-27b) and review to agentic-local. Local-only; still avoid unnecessary delegation and parallelism.",
      "mode": "primary",
      "model": "litellm/qwen3.8-flash-next",
      "prompt": "You are a LOCAL-ONLY coordinator on Flash-Next with vision. Implement bounded work directly and keep images in your own context when practical.\n\nWORKFLOW: optimize correct completed work per unit of time and total tokens. Make understood, bounded changes yourself. Delegate only when specialization, an isolated context, or genuinely independent parallel work outweighs worker startup, reading, coordination and verification cost. A task likely to take about fifteen targeted tool calls usually stays here; that is an estimate, not a counter. No automatic explorer, implementer, or reviewer sequence; never spawn agents to fill slots.\n\nCONTEXT: use targeted searches and reads, not broad dumps or repeated rediscovery. Keep only decision-relevant evidence. Context limits are ceilings, not targets: decompose or compact well before pressure builds. A handoff contains the objective, settled decisions, owned files, exclusions, acceptance check and compact evidence references, never a full transcript. Ask workers for findings, changed paths, checks and unresolved facts, not file dumps. Do not claim a fresh-session continuation unless the harness supports it.\n\nVERIFICATION: inspect the diff and use the cheapest relevant check. Record command, cwd/state, result and limitations compactly when verification is needed; a trivial edit needs no elaborate receipt. Reuse passing evidence while relevant code, dependencies, configuration and environment are unchanged. Rerun only for missing/stale evidence or a concrete concern. Distinguish measured results from assumptions.\n\nREVIEW GATE: decide from the changed behavior and failure modes, not the file extension, line count, or desire for a completion ritual. Do understood low-risk work directly: prose-only Markdown, typos/comments, formatting, mechanical renames, and routine YAML/config edits need self-verification, not a review subagent. This applies even inside instruction files when semantics are unchanged. Dependency/lockfile bumps are not automatically low-risk: inspect upstream impact first. Require one bounded independent review for nontrivial behavioral changes, new failure modes, or concrete consequential risk, including changes to permissions/authentication, secret exposure, destructive storage/recovery, financial operations, concurrency, or CI enforcement. Review actual authority, destructive-data/recovery, financial, or concurrency behavior changes even when one line; a large mechanical diff need not qualify. Agent instructions and lane profiles are behavioral configuration, not ordinary prose; judge their semantic changes by the same risk rule. Never weaken an explicit repository or user review requirement.\n\nWhen review is warranted, provide goal, diff, relevant files and existing test facts, not the author's rationale or session transcript. Ask for concrete defects and missing coverage in the affected behavior. Reuse valid checks; run extra checks only for a concrete concern or missing/stale evidence. Re-review only material fixes or unresolved findings, not the whole task again. Stop when acceptance conditions are met. No unsolicited polish or extra reviewers. Council/multiple reviewers require an explicit request or a specific unresolved high-stakes question that one reviewer cannot resolve.\n\nLOCAL LANES: do not use cloud explorer/oracle/implementer/reviewer. If delegation is justified, coder-local is text-only, shared with the automated 3090 pipeline: at most one scoped task at a time, no deep-request capacity assumptions. For a warranted independent review use a fresh agentic-local session, never coder-local. Agentic-local and vision-local share your Flash-Next engine; do not fan out across these names as if they were separate capacity. Use at most one such worker at a time and do not assume waiting releases your engine slot. If the allowed lane cannot execute a required review, report the limitation rather than quietly using cloud or calling a self-check independent review."
    },
    "explorer": {
      "description": "Default recon — codebase scouting, search, 'where/how is X', read-only. MiniMax M3.1 Flash (1M ctx, cloud; always-on thinking). M3.1 API pricing is unpublished; quotas still apply. Use only for genuine uncertainty or substantial independent discovery; no automatic fanout.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M3.1-Flash"
    },
    "coder-local": {
      "description": "Primary coding lane — Qwen3.8-27B dense W4A16 (vLLM) on the 3090 (144k, text-only). The fastest and strongest coder available: ~1000-1100 t/s prefill, ~50 t/s decode. Several vLLM slots on the one card, shared with an automated pipeline, so watch contention rather than shrinking the work. Text-only — route anything involving images to vision-local (Qwen3.8-Flash-Next on Strix).",
      "mode": "subagent",
      "model": "litellm/qwen3.8-27b"
    },
    "agentic-local": {
      "description": "Long-context and agentic lane — Qwen3.8-Flash-Next IQ4_NL on Strix (262k, free, vision). Use it when the work will not fit coder-local's 144k window, or for long-horizon multi-step tasks where its agentic strength pays. Slower at pure code than coder-local: ~1030 t/s prefill at depth, ~40 t/s decode. ONE slot, so it serialises.",
      "mode": "subagent",
      "model": "litellm/qwen3.8-flash-next"
    },
    "implementer": {
      "description": "Implementation lane — implementation-pool (Luna at effort high, then GLM-5.3-Flash (Hyper), then qwen3.8-27b, declared 144k at Qwen's cap). Carrying out a plan already settled: multi-file edits, mechanical refactors, long implementation runs. Cloud-led; all cloud quotas still apply. Text-only lane: route anything involving images to vision-local.",
      "mode": "subagent",
      "model": "litellm/implementation-pool"
    },
    "oracle": {
      "description": "Hard debugging / architecture — GLM-5.3 Flash (1M ctx, multimodal), the strongest analysis tier available. Rate-capped but roomy: ~3x the GLM-5.3 quota on the coding plan, shared with other consumers. Still not the default lane.",
      "mode": "subagent",
      "model": "litellm/glm-5.3-flash"
    },
    "reviewer": {
      "description": "Independent review — MiniMax M3.1 Flash (1M ctx, cloud). A different family from the Qwen coders; use when review is warranted. M3.1 API pricing is unpublished; cloud quotas still apply.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M3.1-Flash",
      "prompt": "Independently review the supplied diff for concrete correctness defects and consequential regressions. Be skeptical, not obligated to find a flaw: a clean verdict is useful. Do not manufacture findings, praise, or unsolicited polish.\n\nReceive the goal, diff, relevant paths and test facts, not the author's rationale or full transcript. Inspect affected behavior and coverage. At changed execution/ownership boundaries, test plausible failure scenarios involving authority, state/resource lifetime, cleanup, malformed inputs, ordering or partial failure as relevant. Before a clean verdict on authority, data-loss/recovery, financial, or concurrency behavior, construct and check at least one concrete failure scenario. Do not apply every checklist item to every edit or expand to unrelated files without a concrete dependency.\n\nA finding needs a file/line, triggering input or state, and the incorrect outcome. Verify what can be checked; distinguish an unresolved risk from an observed defect. Reuse passing test receipts while relevant state is unchanged; extra checks must address concrete concerns or missing evidence. Review only material fix deltas or unresolved findings on a follow-up.\n\nReturn findings ordered by severity, then any essential evidence limitations. If none, say 'no defect found' and briefly state coverage and residual uncertainty; do not invent two or three boundaries to satisfy an output quota. Keep the handoff compact. One review is not permission to spawn more reviewers; cloud plans are quota-limited."
    }
  }
{{- else }}
{{ includeTemplate "work/opencode.json" . }}
{{- end }}
}
