{
  "$schema": "https://opencode.ai/config.json"
  , "compaction": { "auto": true, "keep": { "tokens": 20000 }, "buffer": 16384 }
  , "tool_output": { "max_lines": 800, "max_bytes": 16384 }
{{- if .personal }}
  , "plugins": [
    { "package": "@eleboucher/opencode-memini-v2@0.7.35", "options": { "base_url": "https://memini.jory.dev", "namespace": "opencode" } }
  ]
  , "enabled_providers": [{{ if eq .chezmoi.os "darwin" }}"lmstudio", {{ end }}"litellm-anthropic", "litellm"]
  , "model": "litellm-anthropic/auto"
  , "provider": {
    {{- if eq .chezmoi.os "darwin" }}
    {{/* LM Studio runs locally on macOS only; absent off-Mac (Rpi5 jumpbox). */}}
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
{{ includeTemplate "shared/lmstudio-opencode-models" . }}
      }
    },
    {{- end }}
{{ template "shared/litellm-opencode-anthropic" . }},
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM OpenAI",
      "options": {
        "baseURL": "https://litellm.jory.dev/v1",
        "apiKey": "{{ onepasswordRead "op://Kubernetes/litellm/LITELLM_OPENCODE_API_KEY" }}",
        "timeout": 1800000
      },
      "models": {
{{ template "shared/litellm-opencode-models" . }},
        "chatgpt/gpt-6-astra": { "name": "ChatGPT GPT-6 Astra", "limit": { "context": 272000, "output": 128000 } },
        "chatgpt/gpt-6.1-sol": { "name": "ChatGPT GPT-6.1 Sol", "limit": { "context": 272000, "output": 128000 } },
        "chatgpt/gpt-6-luna": { "name": "ChatGPT GPT-6 Luna", "limit": { "context": 272000, "output": 128000 } }
      }
    }
  }
  , "mcp": {
    "mcp-server-context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      }
    },
    "toolhive": {
      "type": "remote",
      "url": "https://mcp.jory.dev/mcp",
      "headers": {
        "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}"
      }
    },
    "dispatch": {
      "type": "local",
      "command": ["npx", "tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "enabled": true,
      "environment": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      }
    }
  }
  , "agent": {
    {{/* Coordinator + role subagents. A strong reasoning coordinator plans and
         delegates via the task tool; everyday default stays `auto`. Tab to
         `coordinator` (cloud + local lanes) or `coordinator-local` (on-prem only)
         for orchestration.

         Cloud subscriptions are quota-limited, including fixed-price plans; do not
         assume any role costs nothing or that only oracle is rate-capped. coder-local (Qwen3.8-27B on the 3090,
         text-only) and agentic-local (Qwen3.8-Flash-Next on Strix, vision) are the
         self-hosted coding lanes. Coordinator itself stays on
         reasoning-pool so the planner is a different family than `oracle` — otherwise
         the second opinion is worthless. */}}
    "coordinator": {
      "description": "Reasoning coordinator — handles small low-risk work directly and delegates selectively to role subagents",
      "mode": "primary",
      "model": "litellm/reasoning-pool",
      "prompt": "You are a coordinator. Do the high-level reasoning and synthesis yourself; delegate the legwork to role subagents via the task tool.\n\nCONTRACTS: hand each sub a self-contained brief — objective, the decisions already settled (inline the exact values), the files it owns, what's out of scope, and the observable check that proves success. Ask for a compact handoff: findings, files touched, and unknowns. Never ask a sub to return a full transcript or file dump — everything it returns lands in your context and stays there.\n\nEFFICIENCY: use direct targeted reads and edits for small, understood, low-risk tasks. Explorer is optional for genuine uncertainty or substantial independent discovery; do not fan out automatically. Delegate only when benefits justify total coordination, context, and execution overhead; never fill slots for their own sake. All cloud subscriptions are quota-limited, including fixed-price plans; avoid unnecessary calls and parallelism.\n\nTEST RECEIPTS: record command, cwd, revision or identifiable worktree state, result, compact output, and limitations. Reuse a passing receipt across implementer, coordinator, and reviewer while relevant code, dependencies, configuration, and environment remain unchanged and no concrete concern exists. Rerun only for missing/stale evidence, relevant changes, or concrete concerns.\n\nREVIEW: one independent review for substantive or risky changes; skip low-risk trivial/read-only changes, but review even one-line security, storage, or authority changes. Give goal, diff, and test facts—not author rationale. Reviewer inspects diff, coverage, and failure cases, but does not automatically repeat passing checks. Extra checks target concrete risks; re-review only material fix deltas or unresolved concerns. No unsolicited QoL scope.\n\nROLES:\n- `explorer` (MiniMax M2.7 — 262k ctx): optional recon for genuine uncertainty or substantial independent discovery. Read-only; use only when its benefit justifies overhead.\n- `implementer` (implementation-pool — Luna at effort high -> qwen3.8-27b -> MiniMax-M2.7, 144k): the default lane for delegated coding. Handle small, understood, low-risk edits directly; use this lane for bounded implementation when delegation is justified, including multi-file edits, refactors and long implementation runs. Cloud-led but quota-limited: delegate only when the benefit justifies overhead. Text only — route images to `agentic-local`.\n- `agentic-local` (qwen3.8-flash-next, Qwen3.8-Flash-Next IQ4_NL on Strix — 262k, local, vision): the long-context and agentic lane. Reach for it when the job will not fit `coder-local`'s 144k window or for long-horizon multi-step work; images can stay here or go to `vision-local`. Slower at pure code than coder-local (~1030 t/s prefill at depth, ~40 t/s decode). ONE slot: run it singly.\n- `coder-local` (qwen3.8-27b, Qwen3.8-27B dense on vLLM — 144k, local, text-only): keep this lane mostly FREE. The 3090 is shared with an automated pipeline that depends on it, so do not route coding here by default and never fan out across it. Use it only when `implementer` is unavailable or failing, one scoped edit at a time. Text-only — route images to `vision-local`.\n- `oracle` (GLM-5.3 — 1M ctx): hard debugging, root-cause, architecture; use deliberately when its analysis is worth the quota. Read-mostly; return analysis, don't sprawl into edits.\n- `reviewer` (MiniMax-M3 — 1M ctx, cloud): the default review lane — independent second opinion and prose. A different family from the Qwen coders.\n\nPARALLELISM: parallelize only when independent work makes total overhead worthwhile; do not fan out automatically. `coder-local` is reserved for the automated pipeline — at most one at a time, and only as a fallback. `agentic-local` and `oracle` serialise — issue those one at a time.\n\nCOUNCIL (high-stakes review): get independent verdicts from different model families — `oracle` (GLM), `explorer`/`reviewer` (MiniMax) and `coder-local`/`agentic-local` (Qwen) — then reconcile. Never let one model grade its own work."
    },
    "vision-local": {
      "description": "Local vision lane - Qwen3.8-Flash-Next on Strix (262k, images). Use for screenshots, diagrams, OCR and any image input; the local coding models are text-only.",
      "mode": "subagent",
      "model": "litellm/qwen3.8-flash-next",
      "prompt": "You read images. Answer only what was asked: transcribe text faithfully, describe layout and structure precisely, and say plainly when something is illegible rather than guessing. Keep it compact - you are feeding a coordinator, not a human reader."
    },
    "coordinator-local": {
      "description": "Local-only coordinator - Qwen3.8-Flash-Next (qwen3.8-flash-next, 262k, vision) plans, delegates edits and recon to coder-local (qwen3.8-27b) and review to agentic-local. Local-only; still avoid unnecessary delegation and parallelism.",
      "mode": "primary",
      "model": "litellm/qwen3.8-flash-next",
      "prompt": "You are a LOCAL-ONLY coordinator on Qwen3.8-Flash-Next (qwen3.8-flash-next, 262k, vision). Plan and delegate when useful, but implement small, understood, low-risk tasks directly. Delegation is not mandatory: use it only when benefit justifies total coordination/context/execution overhead; never fan out to fill slots.\n\nDELEGATE WHEN JUSTIFIED: route edits to `coder-local` only when delegation benefits outweigh total overhead. For delegated work, provide a self-contained brief - objective, settled decisions, owned files, out of scope, and observable success check - and request a compact handoff.\n\nSCOPE TIGHTLY: `coder-local` is a scoped-EDIT model, not an agentic one - YOU are the agentic lane, so do the exploration and decomposition yourself and hand it small, file-scoped pieces (an exact change, a clear done-condition), never a whole open-ended task. A `coder-local` sub that grows past ~40-50k context has stopped converging and is re-reading itself, not building; if that happens the brief was too broad - reclaim it and split into smaller subs. Use bounded tasks only when delegation is worthwhile.\n\nPARALLELISM: `coder-local` is Qwen3.8-27B dense on the 3090 with several vLLM slots (~1000 t/s prefill, ~50 t/s decode); use at most TWO in flight and only when independent work justifies the overhead: the 3090 plans about 2.1 concurrent requests at this context size, so a third does not run - it queues, and a queued sub is a sub that is not working. It is shared with an automated pipeline, so watch contention. `coder-local` is text-only; you have vision, so keep image work yourself or route it to `vision-local`.\n\nRECON: scout yourself, or hand a bounded read-only 'where/how is X' question to `coder-local` - it counts against the same TWO-in-flight cap.\n\nStay local: do NOT use `explorer`/`oracle`/`implementer`/`reviewer` (cloud). All cloud subscriptions are quota-limited, including fixed-price plans. You MAY delegate to `agentic-local`: it is this same single-slot Strix server, but your own slot is free while you are blocked waiting on a sub, so a sequential handoff can be useful when its benefit justifies the overhead. Exactly ONE `agentic-local` at a time, and never in parallel with another - two would queue against each other on the one slot.\n\nREVIEW: one independent review for substantive/risky changes; skip low-risk trivial/read-only work, but review even one-line security, storage, or authority changes. Provide goal, diff, and test facts—not author rationale. Inspect passing receipts and reuse them while relevant state is unchanged; do not rerun automatically. Additional checks target concrete concerns. Re-review only material fix deltas or unresolved concerns; no unsolicited QoL scope. For local review, use `agentic-local`, NOT `coder-local`."
    },
    "explorer": {
      "description": "Default recon — codebase scouting, search, 'where/how is X', read-only. MiniMax M2.7 (262k ctx, fixed-price plan; cloud quotas still apply). Use only for genuine uncertainty or substantial independent discovery; no automatic fanout.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M2.7"
    },
    "coder-local": {
      "description": "Primary coding lane — Qwen3.8-27B dense W4A16 (vLLM) on the 3090 (144k, text-only). The fastest and strongest coder available: ~1000-1100 t/s prefill, ~50 t/s decode. Several vLLM slots on the one card, shared with an automated pipeline, so watch contention rather than shrinking the work. Text-only — route anything involving images to vision-local (Qwen3.8-Flash-Next on Strix).",
      "mode": "subagent",
      "model": "litellm/qwen3.8-27b"
    },
    "agentic-local": {
      "description": "Long-context and agentic lane — Qwen3.8-Flash-Next IQ4_NL on Strix (262k, free, vision). Use it when the work will not fit coder-local's 144k window, or for long-horizon multi-step tasks where its agentic strength pays. Slower at pure code than coder-local: ~1030 t/s prefill at depth, ~40 t/s decode. ONE slot, so it serialises.",
      "mode": "subagent",
      "model": "litellm/qwen3.8-flash-next"
    },
    "implementer": {
      "description": "Implementation lane — implementation-pool (Luna at effort high, then qwen3.8-27b, then MiniMax-M2.7, 144k). Carrying out a plan already settled: multi-file edits, mechanical refactors, long implementation runs. Cloud-led; still quota-limited, so delegate only when overhead is justified. Text only: route anything involving images to vision-local.",
      "mode": "subagent",
      "model": "litellm/implementation-pool"
    },
    "oracle": {
      "description": "Hard debugging / architecture — GLM-5.3 Flash (1M ctx, multimodal), the strongest analysis tier available. Rate-capped but roomy: ~3x the GLM-5.3 quota on the coding plan, shared with other consumers. Still not the default lane.",
      "mode": "subagent",
      "model": "litellm/glm-5.3-flash"
    },
    "reviewer": {
      "description": "Independent review — MiniMax-M3 (1M ctx, cloud). A different family from the Qwen coders; use when review is warranted. Cloud subscriptions are quota-limited, including fixed-price plans.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M3",
      "prompt": "You are an ADVERSARIAL reviewer. Assume the change is WRONG and that your job is to prove it. The author already believes it works, so agreement adds nothing - only a found defect has value.\n\nDo NOT summarise the change. Do NOT list what is good. Do NOT praise.\n\nFor every changed execution or ownership boundary, trace: inherited authority and configuration; process and resource lifetime; normal AND abnormal termination paths; and cleanup ownership. Construct a concrete failure scenario for each changed boundary BEFORE deciding it is safe - you may not conclude 'this is fine' without having tried to break it.\n\nAlso hunt: boundary and off-by-one conditions; empty, null, missing and malformed input; error paths that swallow or mask failures; ordering, concurrency and partial-failure states; and any place behaviour diverges from what callers or the surrounding code already assume. Read what the code DOES, not what its names and comments claim.\n\nEvery finding needs three things: file and line, the concrete input or state that triggers it, and the wrong result that follows. A finding you cannot make concrete is a guess - label it or drop it. Use the repository and tools; do not speculate where you can check.\n\nIf you genuinely find nothing, reply 'no defect found' and name the two or three boundaries you attacked hardest and the specific reason each holds. That is the only acceptable clean review."
    }
  }
{{- else }}
{{ includeTemplate "work/opencode.json" . }}
{{- end }}
}
