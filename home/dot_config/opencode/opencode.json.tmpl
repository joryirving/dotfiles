{
  "$schema": "https://opencode.ai/config.json"
  , "compaction": { "auto": true, "prune": true, "preserve_recent_tokens": 20000, "reserved": 16384 }
  , "tool_output": { "max_lines": 800, "max_bytes": 16384 }
{{- if .personal }}
  , "plugin": [
    ["@eleboucher/opencode-memini@0.7.20", { "base_url": "https://memini.jory.dev", "namespace": "opencode" }]
  ]
  , "enabled_providers": [{{ if eq .chezmoi.os "darwin" }}"lmstudio", {{ end }}"litellm-anthropic", "litellm"]
  , "model": "litellm-anthropic/auto"
  , "provider": {
    {{- if eq .chezmoi.os "darwin" }}
    {{/* LM Studio runs locally on macOS only; absent off-Mac (Rpi5 jumpbox). */}}
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": { "name": "Qwen3.6 35B-A3B" },
        "gemma-4-26b-a4b-it-qat": { "name": "Gemma 4 26B" }
      }
    },
    {{- end }}
{{ template "shared/litellm-opencode-anthropic" . }},
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM OpenAI",
      "options": {
        "baseURL": "https://litellm.jory.dev/v1",
        "apiKey": "{{ onepasswordRead "op://Kubernetes/litellm/LITELLM_OPENCODE_API_KEY" }}",
        "timeout": 1800000
      },
      "models": {
{{ template "shared/litellm-opencode-models" . }},
        "chatgpt/gpt-5.6-sol": { "name": "ChatGPT GPT-5.6 Sol", "limit": { "context": 1100000, "output": 128000 } },
        "chatgpt/gpt-5.6-terra": { "name": "ChatGPT GPT-5.6 Terra", "limit": { "context": 1050000, "output": 128000 } },
        "chatgpt/gpt-5.6-luna": { "name": "ChatGPT GPT-5.6 Luna", "limit": { "context": 1050000, "output": 128000 } }
      }
    }
  }
  , "mcp": {
    "mcp-server-context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      }
    },
    "toolhive": {
      "type": "remote",
      "url": "https://mcp.jory.dev/mcp",
      "headers": {
        "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}"
      }
    },
    "konflate": {
      "type": "remote",
      "url": "https://konflate.jory.dev/mcp"
    },
    "dispatch": {
      "type": "local",
      "command": ["npx", "tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "enabled": true,
      "environment": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      }
    }
    {{- if eq .chezmoi.os "darwin" }}
    {{/* macOS-only local servers (Homebrew binaries). Off-Mac (e.g. Rpi5 jumpbox)
         these tools are reached through the toolhive gateway, which aggregates them. */}}
    , "github": {
      "type": "local",
      "command": ["/opt/homebrew/lib/node_modules/@modelcontextprotocol/server-github/dist/index.js"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ onepasswordRead "op://Kubernetes/github-miso/GITHUB_TOKEN" }}"
      }
    }
    , "kubectl": {
      "type": "local",
      "command": ["/opt/homebrew/lib/node_modules/@strowk/mcp-k8s-darwin-arm64/bin/mcp-k8s-go"],
      "enabled": true
    }
    , "unifi-network": {
      "type": "local",
      "command": ["uvx", "--python-preference", "system", "unifi-network-mcp@latest"],
      "enabled": true,
      "environment": {
        "UNIFI_NETWORK_HOST": "unifi.internal",
        "UNIFI_NETWORK_USERNAME": "{{ onepasswordRead "op://Kubernetes/unifi/OPENCODE_UNIFI_USER" }}",
        "UNIFI_NETWORK_PASSWORD": "{{ onepasswordRead "op://Kubernetes/unifi/OPENCODE_UNIFI_PASS" }}",
        "UNIFI_TOOL_REGISTRATION_MODE": "meta_only",
        "UNIFI_POLICY_CREATE": "false",
        "UNIFI_POLICY_UPDATE": "false",
        "UNIFI_POLICY_DELETE": "false",
        "UNIFI_TOOL_PERMISSION_MODE": "confirm"
      }
    }
    {{- end }}
  }
  , "agent": {
    {{/* Coordinator + role subagents (taxonomy borrowed from oh-my-opencode:
         explorer/fixer/fixer-bigctx/oracle/reviewer, council as a coordinator behavior).
         Strong reasoning coordinator plans and delegates via the task tool;
         everyday default stays `auto`. Tab to coordinator for orchestration.

         Routing bias: no role sits on the Opencode Go sub any more — it is cancelled
         and lapses 2026-08-28. explorer runs on MiniMax-M3, whose plan is flat rather
         than dollar-denominated, so the fan-out lane costs nothing at the margin;
         oracle is glm-5.3. The rest are self-hosted.
         `nvidia` stays the low-latency lane for small edits and carries
         vision: it serves Qwen3.8-27B at 140k with the projector encoding on CPU.
         The Strix lanes are selectable rather than auto-routed — `self-hosted` is the
         Qwen3.6-35B-A3B unsloth build (262k, vision), `llama-reviewer` is the Foreman
         reviewer's model, and `vision` is the abliterated MiniCPM-V 4.5 on Strix
         for image work that must not refuse.
         Coordinator itself stays on reasoning-pool so the planner is a different family
         than `oracle` — otherwise the second opinion is worthless. */}}
    "coordinator": {
      "description": "Reasoning coordinator — plans, then delegates to role subagents (explorer/fixer/fixer-bigctx/oracle/reviewer)",
      "mode": "primary",
      "model": "litellm/reasoning-pool",
      "prompt": "You are a coordinator. Do the high-level reasoning and synthesis yourself; delegate the legwork to role subagents via the task tool.\n\nCONTRACTS: hand each sub a self-contained brief \u2014 objective, the decisions already settled (inline the exact values), the files it owns, what's out of scope, and the observable check that proves success. Ask for a compact handoff: findings, files touched, and unknowns. Never ask a sub to return a full transcript or file dump \u2014 everything it returns lands in your context and stays there.\n\nCAPACITY: every lane below is either flat-rate or local except `oracle`. Concurrency, not cost, is what differs.\n\nROLES:\n- `explorer` (MiniMax M2.7 \u2014 262k ctx, flat-rate, 3-4 concurrent): default recon. Search, 'where/how is X', parallel scouting. Read-only. The only lane with real concurrency \u2014 fan out several at once; this is how you buy context.\n- `fixer` (llama-nvidia, Qwen3.8-27B \u2014 140k, local, multimodal): fast scoped edits and the image lane. ONE slot and contended by an automated pipeline, so keep jobs small and bounded.\n- `fixer-bigctx` (llama-strix, Qwen3.6-35B-A3B \u2014 262k, local, multimodal): bulk implementation needing a large window. ONE slot: run it singly, concurrent instances only queue.\n- `oracle` (GLM-5.3 \u2014 1M ctx): hard debugging, root-cause, architecture. The ONLY rate-capped lane (~80 prompts/5h, shared with other consumers) \u2014 use deliberately, never by default. Read-mostly; return analysis, don't sprawl into edits.\n- `reviewer` (llama-reviewer \u2014 262k, local, 2 slots): independent second opinion and prose.\n\nPARALLELISM: fan out `explorer` freely; it is the only lane that runs concurrently. `fixer`, `fixer-bigctx` and `oracle` serialise \u2014 issue those one at a time.\n\nCOUNCIL (high-stakes review): get independent verdicts from different model families \u2014 `oracle` (GLM), `reviewer` (Nemotron), `explorer` (MiniMax) and `fixer`/`fixer-bigctx` (Qwen) \u2014 then reconcile. Never let one model grade its own work."
    },
    "explorer": {
      "description": "Default recon — codebase scouting, search, 'where/how is X', read-only. MiniMax M2.7 (262k ctx, flat-rate plan, 3-4 concurrent agents). The only lane with real concurrency: fan out freely, several at a time.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M2.7"
    },
    "fixer": {
      "description": "Fast scoped edits — Qwen3.8-27B local on the 3090 (140k, multimodal). Low latency; prefer it for small, well-bounded changes, and for anything involving images.",
      "mode": "subagent",
      "model": "litellm/llama-nvidia"
    },
    "fixer-bigctx": {
      "description": "Primary bulk coding lane — Qwen3.6-35B-A3B unsloth, local on Strix (262k, free, multimodal). Large context for independent implementation attempts. TWO slots.",
      "mode": "subagent",
      "model": "litellm/llama-strix"
    },
    "oracle": {
      "description": "Hard debugging / architecture — GLM-5.3 (1M ctx), the strongest analysis tier available. The ONLY rate-capped lane left (~80 prompts/5h, shared with other consumers): use deliberately, never by default.",
      "mode": "subagent",
      "model": "litellm/glm-5.3"
    },
    "reviewer": {
      "description": "Independent review — Nemotron 3.5 Lightning 30B-A3B, local on Strix (262k, 2 slots, free). Distinct family from the Qwen coders and the MiniMax recon lane. Second opinions and prose.",
      "mode": "subagent",
      "model": "litellm/llama-reviewer"
    },
    "lean": {
      "description": "Minimal MCP context — toolhive router only (reaches other MCPs via call_tool)",
      "mode": "primary",
      "tools": {
        "mcp-server-context7*": false,
        "github*": false,
        "kubectl*": false,
        "konflate*": false,
        "dispatch*": false
      }
    },
    "gitops": {
      "description": "Cluster ops — kubectl/konflate direct on macOS; via toolhive router off-Mac",
      "mode": "primary",
      "tools": {
        "mcp-server-context7*": false,
        "github*": false,
        "dispatch*": false
        {{- if eq .chezmoi.os "darwin" }}
        {{/* kubectl run as local binary here, so reach them directly and
             skip the toolhive router. */}}
        , "toolhive*": false
        {{- end }}
        {{/* Off-Mac the local binaries are absent (see mcp block), so toolhive is
             left enabled — its find_tool/call_tool router reaches kubectl/etc. */}}
      }
    }
  }
{{- else }}
{{ includeTemplate "work/opencode.json" . }}
{{- end }}
}
