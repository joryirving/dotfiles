{
  "$schema": "https://opencode.ai/config.json"
  , "compaction": { "auto": true, "prune": true, "preserve_recent_tokens": 20000, "reserved": 16384 }
  , "tool_output": { "max_lines": 800, "max_bytes": 16384 }
{{- if .personal }}
  , "plugin": [
    ["@eleboucher/opencode-memini@0.7.23", { "base_url": "https://memini.jory.dev", "namespace": "opencode" }]
  ]
  , "enabled_providers": [{{ if eq .chezmoi.os "darwin" }}"lmstudio", {{ end }}"litellm-anthropic", "litellm"]
  , "model": "litellm-anthropic/auto"
  , "provider": {
    {{- if eq .chezmoi.os "darwin" }}
    {{/* LM Studio runs locally on macOS only; absent off-Mac (Rpi5 jumpbox). */}}
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": { "name": "Qwen3.6 35B-A3B" },
        "gemma-4-26b-a4b-it-qat": { "name": "Gemma 4 26B" }
      }
    },
    {{- end }}
{{ template "shared/litellm-opencode-anthropic" . }},
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM OpenAI",
      "options": {
        "baseURL": "https://litellm.jory.dev/v1",
        "apiKey": "{{ onepasswordRead "op://Kubernetes/litellm/LITELLM_OPENCODE_API_KEY" }}",
        "timeout": 1800000
      },
      "models": {
{{ template "shared/litellm-opencode-models" . }},
        "chatgpt/gpt-6-astra": { "name": "ChatGPT GPT-6 Astra", "limit": { "context": 272000, "output": 128000 } },
        "chatgpt/gpt-5.6-sol": { "name": "ChatGPT GPT-5.6 Sol", "limit": { "context": 1100000, "output": 128000 } },
        "chatgpt/gpt-5.6-terra": { "name": "ChatGPT GPT-5.6 Terra", "limit": { "context": 1050000, "output": 128000 } },
        "chatgpt/gpt-5.6-luna": { "name": "ChatGPT GPT-5.6 Luna", "limit": { "context": 1050000, "output": 128000 } }
      }
    }
  }
  , "mcp": {
    "mcp-server-context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      }
    },
    "toolhive": {
      "type": "remote",
      "url": "https://mcp.jory.dev/mcp",
      "headers": {
        "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}"
      }
    },
    "konflate": {
      "type": "remote",
      "url": "https://konflate.jory.dev/mcp"
    },
    "dispatch": {
      "type": "local",
      "command": ["npx", "tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "enabled": true,
      "environment": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      }
    }
    {{- if eq .chezmoi.os "darwin" }}
    {{/* macOS-only local servers (Homebrew binaries). Off-Mac (e.g. Rpi5 jumpbox)
         these tools are reached through the toolhive gateway, which aggregates them. */}}
    , "github": {
      "type": "local",
      "command": ["/opt/homebrew/lib/node_modules/@modelcontextprotocol/server-github/dist/index.js"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ onepasswordRead "op://Kubernetes/github-miso/GITHUB_TOKEN" }}"
      }
    }
    , "kubectl": {
      "type": "local",
      "command": ["/opt/homebrew/lib/node_modules/@strowk/mcp-k8s-darwin-arm64/bin/mcp-k8s-go"],
      "enabled": true
    }
    , "unifi-network": {
      "type": "local",
      "command": ["uvx", "--python-preference", "system", "unifi-network-mcp@latest"],
      "enabled": true,
      "environment": {
        "UNIFI_NETWORK_HOST": "unifi.internal",
        "UNIFI_NETWORK_USERNAME": "{{ onepasswordRead "op://Kubernetes/unifi/OPENCODE_UNIFI_USER" }}",
        "UNIFI_NETWORK_PASSWORD": "{{ onepasswordRead "op://Kubernetes/unifi/OPENCODE_UNIFI_PASS" }}",
        "UNIFI_TOOL_REGISTRATION_MODE": "meta_only",
        "UNIFI_POLICY_CREATE": "false",
        "UNIFI_POLICY_UPDATE": "false",
        "UNIFI_POLICY_DELETE": "false",
        "UNIFI_TOOL_PERMISSION_MODE": "confirm"
      }
    }
    {{- end }}
  }
  , "agent": {
    {{/* Coordinator + role subagents (taxonomy borrowed from oh-my-opencode:
         explorer/fixer/implementer/agentic-local/oracle/reviewer, council as a coordinator behavior).
         Strong reasoning coordinator plans and delegates via the task tool;
         everyday default stays `auto`. Tab to coordinator for orchestration.

         Routing bias: no role sits on the Opencode Go sub any more — it is cancelled
         and lapses 2026-08-28. explorer runs on MiniMax-M3, whose plan is flat rather
         than dollar-denominated, so the fan-out lane costs nothing at the margin;
         oracle is glm-5.3-flash. The rest are self-hosted.
         `nvidia` stays the low-latency lane for small edits and carries
         vision: it serves Qwen3.8-27B at 131k with the projector encoding on CPU.
         The Strix lanes are selectable rather than auto-routed — `self-hosted` is the
         Qwen3.8-Flash-Next unsloth build (262k, vision), `llama-reviewer` is the Foreman
         reviewer's model, and `vision` is the abliterated MiniCPM-V 4.5 on Strix
         for image work that must not refuse.
         Coordinator itself stays on reasoning-pool so the planner is a different family
         than `oracle` — otherwise the second opinion is worthless. */}}
    "coordinator": {
      "description": "Reasoning coordinator — plans, then delegates to role subagents (explorer/fixer/implementer/agentic-local/oracle/reviewer)",
      "mode": "primary",
      "model": "litellm/reasoning-pool",
      "prompt": "You are a coordinator. Do the high-level reasoning and synthesis yourself; delegate the legwork to role subagents via the task tool.\n\nCONTRACTS: hand each sub a self-contained brief \u2014 objective, the decisions already settled (inline the exact values), the files it owns, what's out of scope, and the observable check that proves success. Ask for a compact handoff: findings, files touched, and unknowns. Never ask a sub to return a full transcript or file dump \u2014 everything it returns lands in your context and stays there.\n\nCAPACITY: every lane below is either flat-rate or local except `oracle`. Concurrency, not cost, is what differs.\n\nROLES:\n- `explorer` (MiniMax M2.7 \u2014 262k ctx, flat-rate, 3-4 concurrent): default recon. Search, 'where/how is X', parallel scouting. Read-only. The only lane with real concurrency \u2014 fan out several at once; this is how you buy context.\n- `fixer` (llama-nvidia, Qwen3.8-27B dense UD-Q4_K_XL \u2014 131k, local, vision): the primary coding lane, fastest and strongest at code (~1000 t/s prefill, ~50 t/s decode), and the image lane. TWO time-sliced slots on one 3090, shared with an automated pipeline, so watch contention rather than shrinking the work.\n- `agentic-local` (llama-strix, Qwen3.8-Flash-Next 180B-A6B UD-IQ4_XS \u2014 262k, local, vision): the long-context and agentic lane. Reach for it when the job will not fit `fixer`'s 131k window, or for long-horizon multi-step work. Slower and weaker at pure code (~300 t/s prefill at depth, ~26 t/s decode). ONE slot: run it singly.\n- `implementer` (implementation-pool \u2014 Luna at effort high -> MiniMax-M2.7 -> llama-nvidia, 131k): carrying out a plan already settled \u2014 multi-file edits, mechanical refactors, long implementation runs. Cloud-led, so unlike `fixer` and `agentic-local` it runs CONCURRENTLY: fan out here for implementation the way you fan out `explorer` for recon. Text only \u2014 route images to `fixer`.\n- `oracle` (GLM-5.3 \u2014 1M ctx): hard debugging, root-cause, architecture. The ONLY rate-capped lane (~80 prompts/5h, shared with other consumers) \u2014 use deliberately, never by default. Read-mostly; return analysis, don't sprawl into edits.\n- `reviewer` (llama-reviewer, Gemma-4-12B on the 9070XT \u2014 4 slots, non-Qwen, woken on demand, MiniMax-M3 fallback): independent second opinion and prose.\n\nPARALLELISM: fan out `explorer`, `implementer` and `reviewer` freely; those are the lanes that run concurrently. `fixer`, `agentic-local` and `oracle` serialise \u2014 issue those one at a time.\n\nCOUNCIL (high-stakes review): get independent verdicts from different model families \u2014 `oracle` (GLM), `reviewer` (Gemma), `explorer` (MiniMax) and `fixer`/`agentic-local` (Qwen) \u2014 then reconcile. Never let one model grade its own work."
    },
    "local": {
      "description": "Local-only coordinator - Flash-Next (llama-strix, 262k) plans, delegates edits to the 27B fixer (llama-nvidia) and recon to local-explorer (Gemma on the 9070XT). No rate caps; cloud only if the 9070XT cannot be woken.",
      "mode": "primary",
      "model": "litellm/llama-strix",
      "prompt": "You are a LOCAL-ONLY coordinator on Flash-Next (Qwen3.8-Flash-Next, 262k). Do the planning and synthesis yourself and delegate the legwork. Hand each job a self-contained brief and ask for a compact handoff.\n\nLANES:\n- `fixer` (llama-nvidia, Qwen3.8-27B dense UD-Q4_K_XL - 131k, 3090, vision): the primary coding lane and the strongest coder you have (~1000 t/s prefill, ~50 t/s decode). Two time-sliced slots on the one card, shared with an automated pipeline, so watch contention. Route anything involving images here.\n- `local-explorer` (llama-reviewer, Gemma-4-12B on the 9070XT, 4 slots, non-Qwen): read-only recon and independent second opinions. The only locally concurrent lane, so fan out for scouting. The box is woken on demand, so a first call after idle takes about a minute; if it cannot be woken the request is served by MiniMax in the cloud, which is acceptable.\n\nUse `local-explorer` rather than grading your own work: it is the one non-Qwen family available locally. Do NOT use `explorer`/`oracle`/`implementer` (cloud). Do NOT use `agentic-local` - it is this same single-slot server, so delegating there only queues behind you."
    },
    "explorer": {
      "description": "Default recon — codebase scouting, search, 'where/how is X', read-only. MiniMax M2.7 (262k ctx, flat-rate plan, 3-4 concurrent agents). The only lane with real concurrency: fan out freely, several at a time.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M2.7"
    },
    "fixer": {
      "description": "Primary coding lane — Qwen3.8-27B dense UD-Q4_K_XL on the 3090 (131k, vision). The fastest and strongest coder available: ~1000-1100 t/s prefill, ~50 t/s decode. Two time-sliced slots on the one card, shared with an automated pipeline, so watch contention rather than shrinking the work. Route anything involving images here.",
      "mode": "subagent",
      "model": "litellm/llama-nvidia"
    },
    "agentic-local": {
      "description": "Long-context and agentic lane — Qwen3.8-Flash-Next UD-IQ4_XS, a 180B-A6B MoE on Strix (262k, free, vision). Use it when the work will not fit fixer's 131k window, or for long-horizon multi-step tasks where its agentic strength pays. Slower and weaker at pure code: ~300 t/s prefill at depth, ~26 t/s decode. ONE slot, so it serialises.",
      "mode": "subagent",
      "model": "litellm/llama-strix"
    },
    "implementer": {
      "description": "Implementation lane \u2014 implementation-pool (Luna at effort high, then MiniMax-M2.7, then llama-nvidia, 131k). Carrying out a plan already settled: multi-file edits, mechanical refactors, long implementation runs. Cloud-led, so unlike fixer and agentic-local it runs CONCURRENTLY \u2014 fan out. Text only: route anything involving images to fixer.",
      "mode": "subagent",
      "model": "litellm/implementation-pool"
    },
    "oracle": {
      "description": "Hard debugging / architecture — GLM-5.3 Flash (1M ctx, multimodal), the strongest analysis tier available. Rate-capped but roomy: ~3x the GLM-5.3 quota on the coding plan, shared with other consumers. Still not the default lane.",
      "mode": "subagent",
      "model": "litellm/glm-5.3-flash"
    },
    "local-explorer": {
      "description": "Local recon and second opinion — Gemma-4-12B-it-QAT on the 9070XT (smurf-pc, woken on demand, non-Qwen, 4 slots, vision). The only locally concurrent lane: fan out for scouting. Falls back to MiniMax-M3 if the box cannot be woken.",
      "mode": "subagent",
      "model": "litellm/llama-reviewer"
    },
    "reviewer": {
      "description": "Independent review — Gemma-4-12B-it-QAT on the 9070XT (smurf-pc, part-time, non-Qwen, MiniMax-M3 fallback). Distinct family from the Qwen coders. Second opinions and prose.",
      "mode": "subagent",
      "model": "litellm/llama-reviewer"
    },
    "lean": {
      "description": "Minimal MCP context — toolhive router only (reaches other MCPs via call_tool)",
      "mode": "primary",
      "tools": {
        "mcp-server-context7*": false,
        "github*": false,
        "kubectl*": false,
        "konflate*": false,
        "dispatch*": false
      }
    },
    "gitops": {
      "description": "Cluster ops — kubectl/konflate direct on macOS; via toolhive router off-Mac",
      "mode": "primary",
      "tools": {
        "mcp-server-context7*": false,
        "github*": false,
        "dispatch*": false
        {{- if eq .chezmoi.os "darwin" }}
        {{/* kubectl run as local binary here, so reach them directly and
             skip the toolhive router. */}}
        , "toolhive*": false
        {{- end }}
        {{/* Off-Mac the local binaries are absent (see mcp block), so toolhive is
             left enabled — its find_tool/call_tool router reaches kubectl/etc. */}}
      }
    }
  }
{{- else }}
{{ includeTemplate "work/opencode.json" . }}
{{- end }}
}
