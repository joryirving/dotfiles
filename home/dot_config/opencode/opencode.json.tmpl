{
  "$schema": "https://opencode.ai/config.json"
  , "compaction": { "auto": true, "prune": true, "preserve_recent_tokens": 20000, "reserved": 16384 }
  , "tool_output": { "max_lines": 800, "max_bytes": 16384 }
{{- if .personal }}
  , "plugin": [
    ["@eleboucher/opencode-memini@0.7.29", { "base_url": "https://memini.jory.dev", "namespace": "opencode" }]
  ]
  , "enabled_providers": [{{ if eq .chezmoi.os "darwin" }}"lmstudio", {{ end }}"litellm-anthropic", "litellm"]
  , "model": "litellm-anthropic/auto"
  , "provider": {
    {{- if eq .chezmoi.os "darwin" }}
    {{/* LM Studio runs locally on macOS only; absent off-Mac (Rpi5 jumpbox). */}}
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
{{ includeTemplate "shared/lmstudio-opencode-models" . }}
      }
    },
    {{- end }}
{{ template "shared/litellm-opencode-anthropic" . }},
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM OpenAI",
      "options": {
        "baseURL": "https://litellm.jory.dev/v1",
        "apiKey": "{{ onepasswordRead "op://Kubernetes/litellm/LITELLM_OPENCODE_API_KEY" }}",
        "timeout": 1800000
      },
      "models": {
{{ template "shared/litellm-opencode-models" . }},
        "chatgpt/gpt-6-astra": { "name": "ChatGPT GPT-6 Astra", "limit": { "context": 272000, "output": 128000 } },
        "chatgpt/gpt-5.6-sol": { "name": "ChatGPT GPT-5.6 Sol", "limit": { "context": 1100000, "output": 128000 } },
        "chatgpt/gpt-5.6-terra": { "name": "ChatGPT GPT-5.6 Terra", "limit": { "context": 1050000, "output": 128000 } },
        "chatgpt/gpt-5.6-luna": { "name": "ChatGPT GPT-5.6 Luna", "limit": { "context": 1050000, "output": 128000 } }
      }
    }
  }
  , "mcp": {
    "mcp-server-context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/OPENCODE_API_KEY" }}"
      }
    },
    "toolhive": {
      "type": "remote",
      "url": "https://mcp.jory.dev/mcp",
      "headers": {
        "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}"
      }
    },
    "dispatch": {
      "type": "local",
      "command": ["npx", "tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "enabled": true,
      "environment": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}"
      }
    }
  }
  , "agent": {
    {{/* Coordinator + role subagents. A strong reasoning coordinator plans and
         delegates via the task tool; everyday default stays `auto`. Tab to
         `coordinator` (cloud + local lanes) or `coordinator-local` (on-prem only)
         for orchestration.

         explorer is MiniMax-M2.7 and reviewer is MiniMax-M3 — both flat-rate plans,
         so the recon and review lanes cost nothing at the margin; oracle is
         glm-5.3-flash, the one rate-capped lane. coder-local (Qwen3.8-27B on the 3090,
         text-only) and agentic-local (Qwen3.8-Flash-Next on Strix, vision) are the
         self-hosted coding lanes; local-reviewer and explorer-local are Gemma-4-12B on
         the 9070XT (non-Qwen, woken on demand). Coordinator itself stays on
         reasoning-pool so the planner is a different family than `oracle` — otherwise
         the second opinion is worthless. */}}
    "coordinator": {
      "description": "Reasoning coordinator — plans, then delegates to role subagents (explorer/coder-local/implementer/agentic-local/oracle/reviewer/local-reviewer)",
      "mode": "primary",
      "model": "litellm/reasoning-pool",
      "prompt": "You are a coordinator. Do the high-level reasoning and synthesis yourself; delegate the legwork to role subagents via the task tool.\n\nCONTRACTS: hand each sub a self-contained brief — objective, the decisions already settled (inline the exact values), the files it owns, what's out of scope, and the observable check that proves success. Ask for a compact handoff: findings, files touched, and unknowns. Never ask a sub to return a full transcript or file dump — everything it returns lands in your context and stays there.\n\nCAPACITY: every lane below is either flat-rate or local except `oracle`. Concurrency, not cost, is what differs.\n\nROLES:\n- `explorer` (MiniMax M2.7 — 262k ctx, flat-rate, 3-4 concurrent): default recon. Search, 'where/how is X', parallel scouting. Read-only. The only lane with real concurrency — fan out several at once; this is how you buy context.\n- `coder-local` (qwen3.8-27b, Qwen3.8-27B dense on vLLM — 160k, local, text-only): the primary coding lane, fastest and strongest at code (~1000 t/s prefill, ~50 t/s decode). Several vLLM slots on one 3090, shared with an automated pipeline, so watch contention rather than shrinking the work. Text-only — route images to `vision-local`.\n- `agentic-local` (qwen3.8-flash-next, Qwen3.8-Flash-Next IQ4_NL on Strix — 262k, local, vision): the long-context and agentic lane. Reach for it when the job will not fit `coder-local`'s 160k window or for long-horizon multi-step work; images can stay here or go to `vision-local`. Slower at pure code than coder-local (~1030 t/s prefill at depth, ~40 t/s decode). ONE slot: run it singly.\n- `implementer` (implementation-pool — Luna at effort high -> qwen3.8-27b -> MiniMax-M2.7, 160k): carrying out a plan already settled — multi-file edits, mechanical refactors, long implementation runs. Cloud-led, so unlike `coder-local` and `agentic-local` it runs CONCURRENTLY: fan out here for implementation the way you fan out `explorer` for recon. Text only — route images to `agentic-local`.\n- `oracle` (GLM-5.3 — 1M ctx): hard debugging, root-cause, architecture. The ONLY rate-capped lane (~80 prompts/5h, shared with other consumers) — use deliberately, never by default. Read-mostly; return analysis, don't sprawl into edits.\n- `reviewer` (MiniMax-M3 — 1M ctx, flat-rate, cloud, concurrent): the default review lane — independent second opinion and prose. A different family from the Qwen coders and stronger than the local Gemma.\n- `local-reviewer` (gemma-4-12b-it-qat, Gemma-4-12B on the 9070XT — non-Qwen, 4 slots, woken on demand): optional free local second opinion from a third family. Only a 12B, so weaker than `reviewer` — reach for it for a cheap different-family gut-check or to offload prose, not as the primary review.\n\nPARALLELISM: fan out `explorer`, `implementer`, `reviewer` and `coder-local` freely; those run concurrently now that the 27B serves several slots. `agentic-local` and `oracle` serialise — issue those one at a time.\n\nCOUNCIL (high-stakes review): get independent verdicts from different model families — `oracle` (GLM), `local-reviewer` (Gemma), `explorer`/`reviewer` (MiniMax) and `coder-local`/`agentic-local` (Qwen) — then reconcile. Never let one model grade its own work."
    },
    "vision-local": {
      "description": "Local vision lane - Qwen3.8-Flash-Next on Strix (262k, images). Use for screenshots, diagrams, OCR and any image input; the local coding models are text-only.",
      "mode": "subagent",
      "model": "litellm/qwen3.8-flash-next",
      "prompt": "You read images. Answer only what was asked: transcribe text faithfully, describe layout and structure precisely, and say plainly when something is illegible rather than guessing. Keep it compact - you are feeding a coordinator, not a human reader."
    },
    "coordinator-local": {
      "description": "Local-only coordinator - Qwen3.8-Flash-Next (qwen3.8-flash-next, 262k, vision) plans, delegates edits to coder-local (qwen3.8-27b) and recon/review to explorer-local (Gemma on the 9070XT). No rate caps; cloud only if the 9070XT cannot be woken.",
      "mode": "primary",
      "model": "litellm/qwen3.8-flash-next",
      "prompt": "You are a LOCAL-ONLY coordinator on Qwen3.8-Flash-Next (qwen3.8-flash-next, 262k, vision). Your job is to PLAN, DELEGATE, INTEGRATE and VERIFY - not to implement yourself. Delegation is the whole point of this agent; doing the work solo and serially is the failure mode.\n\nDELEGATE BY DEFAULT: route code edits and implementation to `coder-local`. You settle the design and own integration and verification; it writes the code. For anything past a one-line touch-up, hand it a self-contained brief - objective, the decisions already settled with exact values, the files it owns, what is out of scope, and the observable check that proves success - and ask for a compact handoff (findings, files touched, unknowns). Doing substantial edits yourself is the exception, not the norm.\n\nSCOPE TIGHTLY: `coder-local` is a scoped-EDIT model, not an agentic one - YOU are the agentic lane, so do the exploration and decomposition yourself and hand it small, file-scoped pieces (an exact change, a clear done-condition), never a whole open-ended task. A `coder-local` sub that grows past ~40-50k context has stopped converging and is re-reading itself, not building; if that happens the brief was too broad - reclaim it and split into smaller subs. Several small bounded edits beat one sprawling delegation.\n\nFAN OUT: `coder-local` is Qwen3.8-27B dense on the 3090 with several vLLM slots (~1000 t/s prefill, ~50 t/s decode), so spread those small edits across parallel `coder-local` subs rather than serialising them through yourself. It is shared with an automated pipeline, so watch contention. Text-only: you have vision, so keep image work or route it to `explorer-local`.\n\nRECON: `explorer-local` (Gemma-4-12B on the 9070XT, 4 slots, non-Qwen, read-only) is your scouting and second-opinion lane and the only other locally-concurrent one - fan it out for 'where/how is X' before you plan. Woken on demand, so a first call after idle takes about a minute; if it cannot be woken the request falls back to MiniMax in the cloud, which is fine.\n\nStay local: do NOT use `explorer`/`oracle`/`implementer`/`reviewer` (cloud), and do NOT use `agentic-local` - that is this same single-slot Strix server, so delegating there only queues behind you.\n\nQUALITY PASS (before you report done): after a substantive change, dispatch a fresh `explorer-local` for a critical full pass over the diff - remaining bugs, edge cases, error handling, small QoL wins. Hand it the changed files and the goal, not your reasoning; an independent, near-zero-context, different-family reviewer catches what you talked yourself past. Act on what it flags (through `coder-local`), then re-verify. Skip only for trivial or read-only work."
    },
    "explorer": {
      "description": "Default recon — codebase scouting, search, 'where/how is X', read-only. MiniMax M2.7 (262k ctx, flat-rate plan, 3-4 concurrent agents). The only lane with real concurrency: fan out freely, several at a time.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M2.7"
    },
    "coder-local": {
      "description": "Primary coding lane — Qwen3.8-27B dense W4A16 (vLLM) on the 3090 (160k, text-only). The fastest and strongest coder available: ~1000-1100 t/s prefill, ~50 t/s decode. Several vLLM slots on the one card, shared with an automated pipeline, so watch contention rather than shrinking the work. Text-only — route anything involving images to vision-local (Gemma-4-E4B on Strix) or explorer-local (Gemma-4-12B on the 9070XT).",
      "mode": "subagent",
      "model": "litellm/qwen3.8-27b"
    },
    "agentic-local": {
      "description": "Long-context and agentic lane — Qwen3.8-Flash-Next IQ4_NL on Strix (262k, free, vision). Use it when the work will not fit coder-local's 160k window, or for long-horizon multi-step tasks where its agentic strength pays. Slower at pure code than coder-local: ~1030 t/s prefill at depth, ~40 t/s decode. ONE slot, so it serialises.",
      "mode": "subagent",
      "model": "litellm/qwen3.8-flash-next"
    },
    "implementer": {
      "description": "Implementation lane — implementation-pool (Luna at effort high, then qwen3.8-27b, then MiniMax-M2.7, 160k). Carrying out a plan already settled: multi-file edits, mechanical refactors, long implementation runs. Cloud-led, so unlike coder-local and agentic-local it runs CONCURRENTLY — fan out. Text only: route anything involving images to vision-local.",
      "mode": "subagent",
      "model": "litellm/implementation-pool"
    },
    "oracle": {
      "description": "Hard debugging / architecture — GLM-5.3 Flash (1M ctx, multimodal), the strongest analysis tier available. Rate-capped but roomy: ~3x the GLM-5.3 quota on the coding plan, shared with other consumers. Still not the default lane.",
      "mode": "subagent",
      "model": "litellm/glm-5.3-flash"
    },
    "explorer-local": {
      "description": "Local recon and second opinion — Gemma-4-12B-it-QAT on the 9070XT (smurf-pc, woken on demand, non-Qwen, 4 slots, vision). The only locally concurrent lane: fan out for scouting. Falls back to MiniMax-M3 if the box cannot be woken.",
      "mode": "subagent",
      "model": "litellm/gemma-4-12b-it-qat"
    },
    "reviewer": {
      "description": "Independent review — MiniMax-M3 (1M ctx, flat-rate, cloud, concurrent). A different family from the Qwen coders and stronger than the local Gemma; the default second-opinion and prose lane.",
      "mode": "subagent",
      "model": "litellm-anthropic/MiniMax-M3"
    },
    "local-reviewer": {
      "description": "Optional local second opinion — Gemma-4-12B-it-QAT on the 9070XT (smurf-pc, woken on demand, non-Qwen, 4 slots, vision). Only a 12B, so weaker than the MiniMax-M3 `reviewer`; reach for it for a cheap different-family gut-check or to offload prose, not as the primary review.",
      "mode": "subagent",
      "model": "litellm/gemma-4-12b-it-qat"
    }
  }
{{- else }}
{{ includeTemplate "work/opencode.json" . }}
{{- end }}
}
