// Zed settings — managed by chezmoi.
// Shared settings are below; machine-specific blocks are split by the `personal`
// prompt. Work (non-personal) blocks come from the private `work` submodule.
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "autosave": "on_focus_change",
  "session": {
    "trust_all_worktrees": true,
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
{{- if .personal }}
  // ---- personal ----
  // LM Studio runs locally on the Mac (Zed is macOS-only — see .chezmoiignore).
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "model": "mellum2-12b-a2.5b-thinking",
      "api_url": "http://localhost:1234/v1",
    },
  },
  "context_servers": {
    "mcp-server-context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "{{ onepasswordRead "op://Kubernetes/context7/ZED_API_KEY" }}",
      },
    },
    "memini": {
      "url": "https://memini.jory.dev/mcp",
      "headers": { "X-Memini-Namespace": "zed", "Authorization": "Bearer {{ onepasswordRead "op://Kubernetes/memini/MEMINI_API_KEY" }}" },
    },
    "toolhive": {
      "url": "https://mcp.jory.dev/mcp",
      "headers": { "x-api-key": "{{ onepasswordRead "op://Kubernetes/toolhive/TOOLHIVE_MACBOOK_API_KEY" }}" },
    },
    "dispatch": {
      "command": "npx",
      "args": ["tsx", "{{ .chezmoi.homeDir }}/git/dispatch/src/mcp/server.ts"],
      "env": {
        "DISPATCH_URL": "https://dispatch.jory.dev",
        "DISPATCH_AGENT_TOKEN": "{{ onepasswordRead "op://Kubernetes/dispatch/DISPATCH_AGENT_TOKEN" }}",
      },
    },
  },
  "language_models": {
    // Zed auto-discovers whatever models LM Studio currently has loaded.
    "lmstudio": {
      "api_url": "http://localhost:1234/v1",
    },
    "openai_compatible": {
      "LiteLLM": {
        "api_url": "https://litellm.jory.dev/v1",
        "available_models": [
{{ template "shared/litellm-zed-models" . }},
          {
            "name": "chatgpt/gpt-6-astra",
            "max_tokens": 272000,
            "max_output_tokens": 128000,
            "capabilities": { "tools": true, "images": true, "parallel_tool_calls": true, "prompt_cache_key": true, "chat_completions": true, "interleaved_reasoning": false }
          },
          {
            "name": "chatgpt/gpt-6-sol",
            "max_tokens": 272000,
            "max_output_tokens": 128000,
            "capabilities": { "tools": true, "images": true, "parallel_tool_calls": true, "prompt_cache_key": true, "chat_completions": true, "interleaved_reasoning": false }
          },
          {
            "name": "chatgpt/gpt-6-luna",
            "max_tokens": 272000,
            "max_output_tokens": 128000,
            "capabilities": { "tools": true, "images": true, "parallel_tool_calls": true, "prompt_cache_key": true, "chat_completions": true, "interleaved_reasoning": false }
          },
          {
            "name": "chatgpt/gpt-5.6-sol",
            "max_tokens": 1100000,
            "max_output_tokens": 128000,
            "capabilities": { "tools": true, "images": true, "parallel_tool_calls": true, "prompt_cache_key": true, "chat_completions": true, "interleaved_reasoning": false }
          },
          {
            "name": "chatgpt/gpt-5.6-terra",
            "max_tokens": 1050000,
            "max_output_tokens": 128000,
            "capabilities": { "tools": true, "images": true, "parallel_tool_calls": true, "prompt_cache_key": true, "chat_completions": true, "interleaved_reasoning": false }
          },
          {
            "name": "chatgpt/gpt-5.6-luna",
            "max_tokens": 1050000,
            "max_output_tokens": 128000,
            "capabilities": { "tools": true, "images": true, "parallel_tool_calls": true, "prompt_cache_key": true, "chat_completions": true, "interleaved_reasoning": false }
          }
        ]
      }
    },
{{ template "shared/litellm-zed-anthropic" . }},
  },
  "agent": {
    // No permission prompts: allow tool calls by default. Zed still applies its
    // built-in security rules and any always_deny patterns on top of this.
    "tool_permissions": {
      "default": "allow",
    },
    // Explicit rather than implicit (this is the shipped default since v1.17.2):
    // summarize earlier messages at 90% of the window instead of dying at the
    // limit. It cannot rescue a single turn that thinks past the window.
    "auto_compact": {
      "enabled": true,
      "threshold": "90%",
    },
    "default_model": {
      "provider": "anthropic",
      "model": "auto",
    },
    // Zed has ONE global subagent model (no per-task choice like opencode), so it
    // can't fan out to a cheap Go lane the way opencode's `explorer` does. Kept on
    // nvidia: it is the fastest local lane (54s p95 vs 92-118s for the Strix lanes),
    // though it is heavily contended by Foreman, so keep Zed subagent jobs bounded.
    "subagent_model": {
      "provider": "LiteLLM",
      "model": "qwen3.8-27b",
    },
    // Commit-message path (Zed routes this around the agent panel; AGENTS.md covers the rest).
    "commit_message_instructions": "Conventional Commits: `type(scope): imperative summary`, lowercase, ~50 char subject. Add a body only if the why isn't obvious from the diff — a few tight lines, no walls, no filler adjectives, don't restate the diff.",
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [
      { "provider": "LiteLLM", "model": "frontier-pool" },
      { "provider": "LiteLLM", "model": "reasoning-pool" },
      { "provider": "LiteLLM", "model": "qwen3.8-flash-next" },
      { "provider": "anthropic", "model": "MiniMax-M3" },
      { "provider": "LiteLLM", "model": "dsv4f" },
      { "provider": "LiteLLM", "model": "dsv4.1f" },
      { "provider": "LiteLLM", "model": "glm-5.3-flash" },
      { "provider": "LiteLLM", "model": "glm-5.3" },
    ],
    "model_parameters": [],
  },
  "file_types": {
    "json5": ["*.json5"],
  },
  "line_ending": "prefer_lf",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "model": "gpt-5.4",
        "mode": "full-access",
      },
      "type": "registry",
      "env": {
        "CODEX_HOME": "{{ .chezmoi.homeDir }}/.codex",
      },
    },
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
{{- else }}
{{ includeTemplate "work/zed.json" . }}
{{- end }}
}
